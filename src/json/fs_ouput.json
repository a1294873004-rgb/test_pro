  {
    "id": "kphVFWfD23",
    "parentId": "17-2v0z98h",
    "creationId": "30cefb00-e899-42f1-af39-c21cff403d25",
    "info": {
      "id": "kphVFWfD23",
      "type": "block",
      "props": {
        "alt": "",
        "fit": "contain",
        "url": "https://r.yidooo.com/user/faccfa7f-73ff-4d51-88a7-ac53b9d144c2/2026-02-25/images/generation/1772019625900_f1609487.jpg",
        "xywh": "[31163.577048290328,79026.29854528114,400,266]",
